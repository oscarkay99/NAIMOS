# ---------------------------------------------------------------------------
# NAIMOS Intelligence - environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development          # development | production
DEMO_MODE=true                   # true = synthetic demo data only, never mix with real data

# --- Database (local Docker Postgres+PostGIS) ---
DATABASE_URL=postgresql+psycopg://naimos:naimos_dev_password@localhost:5433/naimos
DATABASE_URL_READONLY=postgresql+psycopg://naimos_readonly:naimos_readonly_password@localhost:5433/naimos

# --- Optional: Supabase (alternative managed Postgres, not used by default) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI ---
# Leave OPENAI_API_KEY empty to use the built-in MockLLMProvider (fully functional
# demo mode, clearly labeled). Set it to switch the app to real OpenAI-compatible calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Map ---
# MapLibre is used with free, token-free vector tiles by default.
# Set MAPBOX_TOKEN only if you switch the frontend to Mapbox styles.
MAPBOX_TOKEN=

# --- Satellite ---
# Leave both empty to use the built-in MockSatelliteProvider (simulated
# change detection over real current imagery). Set both to switch the
# Satellite Monitoring feature to real Sentinel-2 analysis. Defaults target
# the free Copernicus Data Space Ecosystem (dataspace.copernicus.eu) Sentinel
# Hub deployment - create an OAuth client (Client Credentials flow) under
# Dashboards > Sentinel Hub > User settings > OAuth clients. To use the
# commercial services.sentinel-hub.com instead, also override
# SENTINELHUB_TOKEN_URL and SENTINELHUB_STATISTICS_URL.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# --- Storage ---
# Path is relative to the apps/api working directory (where uvicorn/alembic/
# the seed script are run from), NOT the repo root.
STORAGE_PROVIDER=local           # local | s3
STORAGE_BUCKET=naimos-evidence
STORAGE_LOCAL_PATH=./storage

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- Web app ---
NEXT_PUBLIC_API_URL=http://localhost:8000
